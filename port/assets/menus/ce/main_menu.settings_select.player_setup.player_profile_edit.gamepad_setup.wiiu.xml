	<strings name="main_menu/settings_select/player_setup/player_profile_edit/gamepad_setup/wiiu/help_strings">
		<string text=""/>
		<string text="Turning the GamePad aims too: always, or only\nwhile zoomed in through a scope."/>
		<string text="Any hold: turn the GamePad left and right\nhowever you hold it. Lean: like a wheel."/>
		<string text="Holds the view still while you bring the\nGamePad back: a thumb on its screen, or\nwhile the right stick is pushed."/>
		<string text="How far the view turns for the GamePad's\nturn: 1 as far as the pad, 2 twice as far."/>
		<string text="Tilting the top of the GamePad away looks up."/>
		<string text="Auto: by letter in the menus, by place in the\ngame (B jumps). From the next start."/>
		<string text="Separate: a Pro Controller is player 2, for\nsplit screen. From the next start."/>
