	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/detail/help_strings">
		<string text=""/>
		<string text="The grass, pebbles and plants near you. Off\nsaves the game's time in fields of grass."/>
		<string text="Bullet holes, scorch marks and blood left on\nwalls and the ground."/>
		<string text="Sparks, smoke, dust, debris and the trails of\nshots. Off leaves the shots and blasts bare."/>
		<string text="The shadows characters, vehicles and weapons\ncast on the ground."/>
		<string text="The flares and glows of lights and the sun."/>
		<string text="The shine of lights on the level's surfaces,\nand its reflections and mirrors."/>
		<string text="The relief of rock and metal in the level's\nlighting; off lights its surfaces flat."/>
	</strings>
