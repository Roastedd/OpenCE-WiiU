	<strings name="main_menu/settings_select/player_setup/player_profile_edit/gamepad_setup/wiimote/aim/help_strings">
		<string text=""/>
		<string text="Recent sensor-bar samples are blended.\nLower values respond faster; 1 is unfiltered."/>
		<string text="How far the sensor-bar pointer moves the\naim point across the screen."/>
		<string text="Move the weapon within the screen on foot.\nThe camera turns near the aim area's edge."/>
		<string text="How far the weapon aims when you turn the\nRemote. Lower values give finer control."/>
		<string text="Horizontal half-width in degrees. A larger\narea gives more aim before camera turning."/>
